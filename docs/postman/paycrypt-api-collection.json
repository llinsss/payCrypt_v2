{
  "info": {
    "name": "PayCrypt API",
    "description": "PayCrypt API Collection with automated JWT authentication.\n\n## Automated Auth Setup\n1. Set `baseUrl`, `email`, and `password` collection variables.\n2. Run the **Login** request under the Authentication folder.\n3. The response script automatically sets the `token` variable.\n\n## Base URL\n- Local: http://localhost:5002\n\n## Auth Flow\n- Register a new user or Login with existing credentials.\n- Protected endpoints use the Bearer token set by the Login flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "paycrypt"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5002", "type": "string" },
    { "key": "email", "value": "user@example.com", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Register, login, and 2FA management. Login auto-stores the JWT into the `token` collection variable.",
      "item": [
        {
          "name": "Register",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "    var json = pm.response.json();",
                "    pm.collectionVariables.set('token', json.token);",
                "    pm.collectionVariables.set('email', pm.request.body.urlencoded.email || pm.request.body.raw.email);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"tag\": \"testuser\",\n  \"address\": \"0x0000000000000000000000000000000000000000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "description": "Register a new user account. Returns JWT token + user profile."
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "    var json = pm.response.json();",
                "    pm.collectionVariables.set('token', json.token);",
                "} else {",
                "    console.log('Login failed: ' + pm.response.text());",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Login with email/password. Auto-sets the `token` variable for all subsequent requests."
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"YOUR_GOOGLE_ID_TOKEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "auth", "google"] },
            "description": "Login/register with Google OAuth."
          }
        }
      ]
    },
