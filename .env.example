# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:3000/api
# Required. Must start with ws:// (local/dev) or wss:// (any HTTPS-deployed
# environment, to avoid mixed-content connection failures). The app fails
# visibly (console error, real-time updates disabled) if this is unset/invalid.
VITE_WS_URL=ws://localhost:3001
# In production/staging, e.g.: VITE_WS_URL=wss://ws.yourdomain.com

# CDN / static asset delivery (see backend/config/cdn.js)
# Leave CDN_BASE_URL empty to serve assets from the app server as before.
CDN_BASE_URL=
S3_BUCKET=
