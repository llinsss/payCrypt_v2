# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3001
# Optional, dev-only: set to "true" to log polled API responses to the
# console for debugging. Ignored (and never shipped) in production builds.
VITE_DEBUG_API_LOGGING=false

# CDN / static asset delivery (see backend/config/cdn.js)
# Leave CDN_BASE_URL empty to serve assets from the app server as before.
CDN_BASE_URL=
S3_BUCKET=
