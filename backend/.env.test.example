# Deterministic backend test environment (issue #507).
#
# Non-secret values for running the Jest suite on a clean checkout, with no
# personal .env required. Copy to `.env.test` (already picked up automatically
# by tests/setup/testEnv.setup.js) if you want to override a value locally —
# `.env.test` is not read anywhere else and is never loaded in production.
#
# None of these are real credentials. Do not reuse them outside tests.

NODE_ENV=test
PORT=3001

# Local/test-only database. The suite mocks the DB layer in unit tests; the
# few integration tests that need a real database read these values via
# scripts/test-db-setup.js.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taggedpay_test
DB_USER=taggedpay_test
DB_PASSWORD=taggedpay_test_password

# Redis is disabled under NODE_ENV=test (see config/redis.js), so this is
# never dialed — kept only so anything reading it directly has a value.
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=true

# Fake secret, 32+ chars as required by config/env.validation.js. Not used
# to sign anything real.
JWT_SECRET=test-jwt-secret-with-at-least-32-characters
JWT_ISSUER=tagged-backend-test
JWT_AUDIENCE=tagged-api-test

BULL_ADMIN_USER=bull-admin-test
BULL_ADMIN_PASS=bull-admin-test-password
SWAGGER_ADMIN_USER=swagger-admin-test
SWAGGER_ADMIN_PASS=swagger-admin-test-password

CORS_ORIGIN=http://localhost:5173

# Provider secrets used by webhook/service unit tests. Fake values only —
# never point these at sandbox or production provider accounts.
PAYSTACK_SECRET_KEY=sk_test_paystack_secret
MONNIFY_SECRET_KEY=test_monnify_secret_key
MONNIFY_API_KEY=test_monnify_api_key
MONNIFY_CONTRACT_CODE=test_monnify_contract_code
WEBHOOK_SECRET=test-webhook-secret-16
