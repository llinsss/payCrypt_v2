# Database Configuration
DB_HOST=localhost # PostgreSQL hostname
DB_PORT=5432 # PostgreSQL port
DB_NAME=taggedpay # Application database name
DB_USER=taggedpay_user # PostgreSQL username
DB_PASSWORD=your_secure_password # PostgreSQL password; may be empty only for local trust auth

# Automated Backup Configuration
BACKUP_DIR=./backups
BACKUP_FILE_PREFIX=taggedpay
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE_CRON=0 2 * * *
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# JWT Configuration
# REQUIRED: Must be at least 32 characters long
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_required

# Optional: JWT issuer and audience for additional validation
# JWT_ISSUER=tagged-backend
# JWT_AUDIENCE=tagged-api

# Server Configuration
PORT=3000 # HTTP server port
NODE_ENV=development # development, test, or production

# CORS Configuration (for production)
CORS_ORIGIN=http://localhost:5173 # Comma-separated absolute browser origins; required in production
FRONTEND_URL=http://localhost:5173 # Frontend URL used in generated links


RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID # Default EVM RPC endpoint
PRIVATE_KEY=your_private_key # Deployer/service key; keep out of source control
STARKNET_CONTRACT_ADDRESS=0x028add5d29f4aa3e4144ba1a85d509de6719e58cabe42cc72f58f46c6a84a785 # Deployed Starknet contract

# Flow EVM Chain Configuration
# Flow EVM is EVM-compatible; addresses use 8-byte format (0x + 16 hex chars)
FLOW_NETWORK=testnet
FLOW_RPC_URL=https://testnet.evm.nodes.onflow.org
FLOW_CONTRACT_ADDRESS=0x0000000000000000
FLOW_ACCOUNT_ADDRESS=0x0000000000000000
FLOW_PRIVATE_KEY=your_flow_private_key
# ERC-20 token addresses on Flow EVM (optional)
FLOW_USDC_ADDRESS=
FLOW_USDT_ADDRESS=

RECONCILE_MINOR_THRESHOLD=0.01
RECONCILE_MAJOR_THRESHOLD=1.0
RECONCILE_INTERVAL_MS=21600000

# Export (transaction CSV/PDF)
EXPORT_STORAGE_PATH=./storage/exports

# Bull Board Admin UI
BULL_ADMIN_USER=your_bull_admin_username
BULL_ADMIN_PASS=your_strong_bull_admin_password

# Webhooks
WEBHOOK_SECRET=your_global_webhook_admin_secret
WEBHOOK_MAX_RETRIES=5

# Swagger UI
SWAGGER_ADMIN_USER=your_swagger_admin_username
SWAGGER_ADMIN_PASS=your_strong_swagger_admin_password

# Idempotency (24 hours in seconds)
IDEMPOTENCY_TTL=86400

# Rate Limiting Tiers
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_PREMIUM_TIER=1000

# Logging Configuration
LOG_LEVEL=info
LOG_REDACT_FIELDS=password,token,secret,authorization,cookie,x-api-key,apiKey,accessToken,refreshToken,cvv,ssn

# Idempotency Configuration
IDEMPOTENCY_TTL=86400

# Distributed Lock Configuration
LOCK_TIMEOUT=5000
LOCK_RETRY=3

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_key_here
WEBHOOK_MAX_RETRIES=5

# Bull Admin Configuration
BULL_ADMIN_USER=admin
BULL_ADMIN_PASS=tagg@d

# Swagger Admin Configuration
SWAGGER_ADMIN_USER=admin
SWAGGER_ADMIN_PASS=tagg@d

# Sentry Configuration
SENTRY_DSN=your_sentry_dsn_here # Sentry project DSN; leave unset to disable event delivery
SENTRY_TRACES_SAMPLE_RATE=0.1 # Production transaction sample rate, from 0 to 1
SENTRY_PROFILES_SAMPLE_RATE=0.1 # Production profile sample rate, from 0 to 1

# Audit Log Configuration
AUDIT_LOG_RETENTION_DAYS=90

# Circuit Breaker Configuration
CB_TIMEOUT=60000
CB_RESET_TIMEOUT=60000
CB_FAILURE_THRESHOLD=5

# EVM Chain Configuration (Ethereum, Polygon, Base, Arbitrum, Lisk, Flow, U2U)
# Add U2U Network Configuration
U2U_NETWORK=testnet
U2U_RPC_URL=https://rpc-testnet.u2u.xyz
U2U_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
U2U_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
U2U_PRIVATE_KEY=your_u2u_private_key_here

# BASE Network Configuration
BASE_NETWORK=testnet
BASE_RPC_URL=https://sepolia.base.org
BASE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BASE_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
BASE_PRIVATE_KEY=your_base_private_key_here

# FLOW Network Configuration
FLOW_NETWORK=testnet
FLOW_RPC_URL=https://testnet.evm.nodes.onflow.org
FLOW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
FLOW_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
FLOW_PRIVATE_KEY=your_flow_private_key_here

# LISK Network Configuration
LISK_NETWORK=testnet
LISK_RPC_URL=https://rpc.sepolia-api.lisk.com
LISK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
LISK_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
LISK_PRIVATE_KEY=your_lisk_private_key_here
